[Unit]
Description=Private T3 Code gateway for Instabox task %i
After=network-online.target
Wants=network-online.target

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/codex-remote --config %h/.config/codex-remote-runner/config.yaml ui %i --password-file %h/.config/codex-remote-runner/dashboard-password
Restart=on-failure
RestartSec=5
UMask=0077
KillMode=control-group

[Install]
WantedBy=default.target
